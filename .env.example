# ===================================================
# Sushinachos Games — Variáveis de Ambiente
# ===================================================

# Porta da aplicação (padrão EasyPanel: 3000)
PORT=3000

# Conexão PostgreSQL (Banco exclusivo do Sushinachos)
PGHOST=postgres
PGPORT=5432
PGDATABASE=sushinachos
PGUSER=sushinachos_app
PGPASSWORD=troque_por_uma_senha_forte_aqui

# Ou use a connection string completa:
# DATABASE_URL=postgres://sushinachos_app:senha@postgres:5432/sushinachos

# Segredos criptográficos (HMAC para sessões de jogo e cookies do backoffice)
SUSHINACHOS_SESSION_SECRET=defina_um_segredo_aleatorio_longo_aqui
SUSHINACHOS_ADMIN_SECRET=defina_outro_segredo_aleatorio_longo_aqui

# Primeiro Administrador (Bootstrap automático na inicialização do servidor)
SUSHINACHOS_BOOTSTRAP_ADMIN_EMAIL=admin@sushinachos.com.br
SUSHINACHOS_BOOTSTRAP_ADMIN_PASSWORD=defina_uma_senha_com_mais_de_10_caracteres
